# TypeSafe AI Jev System One Configuration
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_MODEL_NAME=jev-rlcd-v1

# System Two LLM Configuration (Fallback)
SYSTEM_TWO_PROVIDER=openai
SYSTEM_TWO_API_KEY=your_openai_api_key_here
SYSTEM_TWO_MODEL_NAME=gpt-4o

# Compliance Firewall Settings
FIREWALL_CONFIDENCE_THRESHOLD=0.90
FIREWALL_ENABLE_DB_AUDIT=true
FIREWALL_ENV=production

# Database Configuration
DATABASE_PATH=data/audit_logs.db

# Logging
LOG_LEVEL=INFO
